    "new-post": "node scripts/new-post.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0"
  }
