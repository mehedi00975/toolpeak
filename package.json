{
  "name": "toolpeak",
  "version": "1.0.0",
  "private": true,
  "description": "ToolPeak — fast, free, browser-only utilities. Static site generator with zero runtime dependencies.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js && node scripts/serve.js",
